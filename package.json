{
  "name": "@kodr/aiwrangler",
  "version": "0.1.3",
  "description": "Ground-truth guardrails for coding agents: deterministic checks plus calibrated semantic judgments against your own spec, rules, and rulings",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kodr-pro/AiWrangler.git"
  },
  "bugs": {
    "url": "https://github.com/kodr-pro/AiWrangler/issues"
  },
  "homepage": "https://github.com/kodr-pro/AiWrangler#readme",
  "keywords": [
    "coding-agent",
    "guardrails",
    "code-review",
    "ai-safety",
    "opencode",
    "mcp",
    "cursor",
    "static-analysis",
    "developer-tools"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "aiwrangler": "dist/cli.js",
    "aiwrangler-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "NOTICE",
    "aiwrangler.config.example.json"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tools": {
      "import": "./dist/tools.js",
      "types": "./dist/tools.d.ts"
    },
    "./plugin": {
      "import": "./dist/plugin.js",
      "types": "./dist/plugin.d.ts"
    },
    "./server": {
      "import": "./dist/plugin.js",
      "types": "./dist/plugin.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run verify:p0 && npm run verify:p1 && npm run verify:p2 && npm run verify:p3 && npm run verify:p4 && npm run verify:mcp && npm run verify:cli && npm run verify:plugin",
    "verify:p0": "tsx scripts/verify-p0.ts",
    "verify:p1": "tsx scripts/verify-p1.ts",
    "verify:p2": "tsx scripts/verify-p2.ts",
    "verify:p3": "tsx scripts/verify-p3.ts",
    "verify:p4": "tsx scripts/verify-p4.ts",
    "verify:p5": "tsx scripts/verify-p5.ts",
    "verify:mcp": "tsx scripts/verify-mcp.ts",
    "verify:cli": "tsx scripts/verify-cli.ts",
    "verify:plugin": "tsx scripts/verify-plugin.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@typesafe-ai/sdk": "^0.6.0",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.4.3",
    "@opencode/plugin": ">=2.1.1"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opencode/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.4.3",
    "@opencode/plugin": "2.1.1",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
